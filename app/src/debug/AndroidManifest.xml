<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only. Exported so adb can reach it, but only callers holding DUMP (the adb
     shell) may; ordinary apps can't. It only changes the local quota count. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".debug.DebugQuotaReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <activity
            android:name=".debug.HiltTestActivity"
            android:exported="false"
            android:theme="@style/Theme.FocusTube" />
    </application>
</manifest>
